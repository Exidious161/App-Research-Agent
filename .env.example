# Copy this file to .env and paste ONE key in. The agent picks whichever
# provider it finds a key for, Anthropic first.

# --- Anthropic (default) ---------------------------------------------------
# https://console.anthropic.com/settings/keys
# Uses the server-side web_search tool, so search runs on Anthropic's side.
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Google Gemini (alternative) -------------------------------------------
# Free key from https://aistudio.google.com/apikey. Uses Google Search grounding.
# GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Optional overrides ----------------------------------------------------
# PROVIDER pins the backend when more than one key is set: anthropic | gemini
# PROVIDER=anthropic
# MODEL overrides that provider's default (claude-opus-5 / gemini-3.7-flash).
# MODEL=claude-opus-5
